# Copy this file to .env and fill in your values for local testing.
# In production (GitHub Actions), set these as repository secrets instead.

# Which AI provider generates the plain-English signal explanations:
#   gemini -> FREE (Google AI Studio, no credit card, ~1,500 requests/day) [default]
#   claude -> paid (Anthropic API, higher quality reasoning)
#   none   -> skip AI entirely, use the templated fallback explanation
AI_PROVIDER=gemini

# Only fill in the key for whichever provider you set above.
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

GEMINI_MODEL=gemini-2.5-flash
CLAUDE_MODEL=claude-sonnet-4-5
DATA_INTERVAL=15m
DATA_PERIOD=5d
ACCOUNT_BALANCE=10000
RISK_PER_TRADE_PCT=1.0
DRY_RUN=false
